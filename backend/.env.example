# ─── AI Provider ──────────────────────────────────────────────────────────────
# Get your free Gemini API key at: https://aistudio.google.com/app/apikey
# Paste it below — this file is never committed to git.
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="AI Code Assistant"
APP_VERSION="1.0.0"
DEBUG=true

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_secret_string_for_jwt_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite for development. Change to postgresql+asyncpg://... for production.
DATABASE_URL=sqlite:///./ai_code_assistant.db

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── AI Provider Selection ────────────────────────────────────────────────────
# Options: gemini | openai  (openai support can be added in Review 2)
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
